AUTOLEDGER_BASE_URL=http://YOUR_SERVER_IP:8080
AUTOLEDGER_PORT=8080
APP_TIMEZONE=America/Argentina/Buenos_Aires
# Use a separate local-only port to avoid colliding with another PostgreSQL.
DB_PORT_BIND=127.0.0.1:55434
DB_VOLUME_NAME=autoledger_hybrid_db_data
DOCUMENTS_VOLUME_NAME=autoledger_hybrid_documents
BACKUPS_VOLUME_NAME=autoledger_hybrid_backups
SECRETS_VOLUME_NAME=autoledger_hybrid_secrets
APP_CONTAINER_NAME=autoledger-hybrid-app
DB_CONTAINER_NAME=autoledger-hybrid-db
BACKUP_CONTAINER_NAME=autoledger-hybrid-backup
